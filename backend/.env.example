DATABASE_URL=postgresql://...          # from Supabase project settings
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=                  # service role key, server-side only
SUPABASE_BUCKET=pcb-vision
JWT_SECRET=
JWT_EXPIRE_HOURS=24
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=your-secure-password
CORS_ORIGINS=http://localhost:3000

# SMTP Email Service Configuration (Default: Gmail SMTP with STARTTLS)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
ADMIN_NOTIFICATION_EMAIL=world.usman.business@gmail.com
APP_BASE_URL=https://pcb-fault-detection-system.vercel.app


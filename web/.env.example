# PCB-Vision Web Platform Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Backend API URL (FastAPI Service)
NEXT_PUBLIC_API_URL=http://localhost:8000

# SMTP Email Configuration (used when proxying/dispatching via SMTP service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
NEXT_PUBLIC_APP_URL=https://pcb-fault-detection-system.vercel.app

